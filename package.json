{
  "name": "bell-explain",
  "version": "1.0.1",
  "description": "Local-first interactive learning workspace for code, papers, documents, and repositories — standalone or part of BELL Suite.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Suzu1Dev/BELL-Explain.git"
  },
  "homepage": "https://github.com/Suzu1Dev/BELL-Explain#readme",
  "bin": {
    "bell-explain": "./bin/bell-explain.mjs"
  },
  "files": [
    "bin",
    "dist",
    "server",
    "!server/**/*.test.ts",
    "shared",
    "!shared/**/*.test.ts",
    "cloud",
    "LICENSE",
    "README.md",
    "README.zh-TW.md",
    "NOTICE",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "prepare": "node -e \"import('node:fs').then(fs=>{if(fs.existsSync('node_modules/vite')&&!fs.existsSync('dist/index.html'))import('node:child_process').then(cp=>cp.execSync('npm run build',{stdio:'inherit'}))})\"",
    "prepack": "npm run build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "BELL_LOG=off tsx --test --test-timeout=120000 server/*.test.ts src/lib/*.test.ts src/components/*.test.ts src/components/learning/*.test.ts src/ui/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sync:server": "tsx --env-file-if-exists=.env cloud/index.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "cheerio": "^1.1.2",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.12.0",
    "ipaddr.js": "^2.2.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-fsrs": "^5.4.2",
    "tsx": "^4.20.0",
    "undici": "^7.30.2",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cmdk": "1.1.1",
    "concurrently": "^9.2.5",
    "happy-dom": "^21.0.4",
    "motion": "14.6.0",
    "tailwindcss": "4.3.2",
    "typescript": "^5.9.0",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
