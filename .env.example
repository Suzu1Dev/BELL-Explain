# BELL Explain 0.2 — copy to .env and restart the local server after changes.
# The default teaching provider is Codex. Run `codex login` on this computer,
# then choose the model, effort and available speed in the web settings.
# BELL uses Codex's own login; do not paste a Codex login token into this file.
# Optional explicit CLI executable path when `codex` is not on PATH:
# CODEX_CLI_PATH=/absolute/path/to/codex
# Claude Code is the second local provider. Run `claude auth login` once in a
# normal terminal; BELL uses the CLI's own login and never reads its credentials.
# Optional explicit CLI executable path when `claude` is not on PATH:
# CLAUDE_CLI_PATH=/absolute/path/to/claude

# Web/API listener; defaults preserve local development on 127.0.0.1:3001.
# For a private server, bind its private interface and explicitly allow its URL.
# BELL_HOST=127.0.0.1
# BELL_PORT=3001
# BELL_ALLOWED_ORIGINS=https://explain.example.internal
# Multiple origins use commas. No wildcards, credentials, paths or trailing slash.
# This is a single-user service; origin checks are not user authentication.

# Optional OpenAI-compatible Chat Completions provider.
# After filling these, choose "OpenAI 相容 API" in the web model settings.
# API mode uses the provider's default effort and speed.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional absolute or project-relative notes SQLite path.
# The other local databases and index-cache/ live beside this file.
# BELL_DATA_PATH=data/bell.sqlite

# Time zone whose midnight starts a new review day.
# BELL_TIMEZONE=Asia/Taipei
# On stop, running lessons get this many seconds to finish. Under the systemd
# unit keep it below 14, or raise TimeoutStopSec with it.
# BELL_DRAIN_SECONDS=10
# JSON event logs go to stdout; set to off to silence them.
# BELL_LOG=on

# Lesson format 3 (one point per step). Off unless set to 1. With synchronization,
# turn it on last: once a format-3 note (or one marked 整理失敗) reaches the sync
# server, every device on an older build stops syncing until it is updated.
# Order: sync server, every device, the format-3 reader in the browser, this flag.
# Rolling back to a build without in-lesson recall (f4987de or older) deletes every
# recall card and its rating when the review queue first opens; back up learning.sqlite first.
# BELL_LESSON_V3=0

# Optional embeddings API, separate from the teaching model.
# Local multilingual embeddings need no API key: enable them in the web UI.
# To use an embeddings API, set these and enable API embeddings in the UI.
# This sends indexed text and search queries to your selected HTTPS service.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=

# Standalone cloud sync server ONLY (`npm run sync:server`).
# Generate a private token with `openssl rand -hex 32`; minimum 32 characters.
# These do not connect or upload notes automatically. Connect explicitly in UI.
# For Docker, use deployment/.env.example and deployment/README.md instead.
# BELL_SYNC_TOKEN=
# BELL_SYNC_DB=data/cloud-sync.sqlite
# HOST=127.0.0.1
# PORT=8080
