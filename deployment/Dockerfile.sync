FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
# The sync server needs only express and zod: skip onnxruntime-node's CUDA download.
RUN ONNXRUNTIME_NODE_INSTALL=skip npm ci
COPY shared ./shared
COPY server ./server
COPY cloud ./cloud
RUN ./node_modules/.bin/esbuild cloud/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build/cloud.mjs
RUN npm prune --omit=dev

FROM node:24-alpine
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080 BELL_SYNC_DB=/data/sync.sqlite
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/build ./build
RUN mkdir /data && chown node:node /data
USER node
EXPOSE 8080
VOLUME /data
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD node -e "fetch('http://127.0.0.1:8080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "build/cloud.mjs"]
